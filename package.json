    "@fontsource/caveat": "5.3.0",
    "@fontsource/kalam": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@fontsource/literata": "5.3.0",
    "@fontsource/opendyslexic": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "@fontsource/shantell-sans": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "fzstd": "^0.1.1",
    "hash-wasm": "4.12.0",
    "katex": "0.19.1",
