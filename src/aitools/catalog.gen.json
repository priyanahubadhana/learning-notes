[
  {
    "id": "notebooks.create",
    "version": 1,
    "label": "Create notebook",
    "group": "Notebooks",
    "summary": "Makes an empty notebook with a title and a look.",
    "aiDescription": "Creates a new empty notebook. Use first when the goal needs a new notebook; later steps add pages, cards and databases with the notebookId it returns. Does not write pages. Do not use to add to an existing notebook.",
    "inputs": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "maxLength": 2000
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "colour": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "view": {
              "enum": ["shelf", "tabs"]
            },
            "pathStyle": {
              "enum": ["simple", "full", "page"]
            },
            "sheet": {
              "enum": ["A4", "Letter"]
            },
            "inkBg": {
              "enum": ["lined", "grid", "dots"]
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "notebookId": {
          "type": "string"
        }
      }
    },
    "writes": [
      {
        "target": "notebook",
        "mode": "create"
      }
    ],
    "permissions": {
      "scope": "notes:write",
      "respectsLocks": true,
      "needsSources": false
    },
    "cost": {
      "class": "none",
      "fill": "none",
      "outTokens": 0
    },
    "tier": "simple",
    "reversible": "batch",
    "risk": "direct",
    "idempotent": true,
    "limits": {
      "timeoutMs": 30000,
      "maxRetries": 3
    },
    "surfaces": ["app", "mcp"],
    "offline": true
  },
  {
    "id": "notebooks.create_from_spec",
    "version": 1,
    "label": "Create notebook from a spec",
    "group": "Notebooks",
    "summary": "Makes a whole notebook (pages, cards) from one written spec.",
    "aiDescription": "Creates a new notebook with all its pages, blocks and recall cards in one step, from a complete ln-spec/1 spec. Use when you already have all the content. For step-by-step building use notebooks.create and then pages.write_notes. Never changes existing notebooks.",
    "inputs": {
      "type": "object",
      "required": ["spec"],
      "additionalProperties": false,
      "properties": {
        "spec": {
          "type": "object",
          "description": "A notebook spec: { version: \"ln-spec/1\", title, summary?, style?, pages: [...], cards?: [...] }."
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "notebookId": {
          "type": "string"
        },
        "pageIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "counts": {
          "type": "object"
        }
      }
    },
    "writes": [
      {
        "target": "notebook",
        "mode": "create"
      },
      {
        "target": "page",
        "mode": "create"
      },
      {
        "target": "cards",
        "mode": "create"
      }
    ],
    "permissions": {
      "scope": "notes:write",
      "respectsLocks": true,
      "needsSources": false
    },
    "cost": {
      "class": "none",
      "fill": "caller",
      "outTokens": 0
    },
    "tier": "writing",
    "reversible": "batch",
    "risk": "direct",
    "idempotent": true,
    "limits": {
      "timeoutMs": 30000,
      "maxRetries": 0
    },
    "surfaces": ["mcp"],
    "offline": false
  },
