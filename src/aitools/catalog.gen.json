  {
    "id": "cards.make_cloze",
    "version": 1,
    "label": "Make fill-in-the-blank cards",
    "group": "Cards",
    "summary": "Turns the notes into cards with hidden words.",
    "aiDescription": "Adds fill-in-the-blank cards to an existing page, under its Recall cards heading. Each card text hides words as {{word}}. Needs pageId from an earlier step. Give cards, or a count and a brief. For question and answer cards use cards.make_recall.",
    "inputs": {
      "type": "object",
      "required": ["pageId"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["cards"]
        },
        {
          "required": ["count"]
        }
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["kind", "text"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "cloze"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000,
                "pattern": "\\{\\{[^{}]+\\}\\}"
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "expectedVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string"
        },
        "cardIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "writes": [
      {
        "target": "blocks",
        "mode": "append"
      },
      {
        "target": "cards",
        "mode": "create"
      }
    ],
    "permissions": {
      "scope": "notes:write",
      "respectsLocks": true,
      "needsSources": true
    },
    "cost": {
      "class": "small",
      "fill": "model",
      "outTokens": 700
    },
    "tier": "simple",
    "reversible": "batch",
    "risk": "direct",
    "idempotent": true,
    "limits": {
      "timeoutMs": 60000,
      "maxRetries": 3
    },
    "surfaces": ["app", "mcp"],
    "offline": false
  },
  {
    "id": "databases.create",
    "version": 1,
    "label": "Create database",
    "group": "Databases",
    "summary": "Adds a table of rows with three starter views.",
    "aiDescription": "Adds one database (columns and rows) to a notebook, with three starter views, and can show it at the end of a page. Needs notebookId from an earlier step. Give the database, or a brief. Use for lists with fields; use pages for prose.",
    "inputs": {
      "type": "object",
      "required": ["notebookId"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["database"]
        },
        {
          "required": ["brief"]
        }
      ],
      "properties": {
        "notebookId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "database": {
          "type": "object",
          "required": ["key", "title", "columns", "rows"],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string",
              "pattern": "^[a-z0-9_-]{1,40}$"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "columns": {
              "type": "array",
              "minItems": 1,
              "maxItems": 30,
              "items": {
                "type": "object",
                "required": ["name", "type"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 60
                  },
                  "type": {
                    "enum": [
                      "text",
                      "number",
                      "date",
                      "checkbox",
                      "choice",
                      "choices",
                      "url"
                    ]
                  },
                  "options": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 50,
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 60
                    }
                  }
                }
              }
            },
            "rows": {
              "type": "array",
              "maxItems": 1000,
              "items": {
                "type": "object",
                "required": ["title"],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "values": {
                    "type": "object",
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "notebookId": {
          "type": "string"
        },
        "databaseId": {
          "type": "string"
        }
      }
    },
    "writes": [
      {
        "target": "database",
        "mode": "create"
      },
      {
        "target": "rows",
        "mode": "create"
      }
    ],
