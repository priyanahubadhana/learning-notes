  {
    "id": "pages.refine",
    "version": 1,
    "label": "Refine page",
    "group": "Pages",
    "summary": "Improves a page block by block, keeping a History copy.",
    "aiDescription": "Edits an existing page one block at a time: add, insert after a block, or replace a block. A copy goes to History first. Big changes wait in the Inbox for Accept. Needs pageId. Give ops, or a brief. Never deletes pages.",
    "inputs": {
      "type": "object",
      "required": ["pageId"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["ops"]
        },
        {
          "required": ["brief"]
        }
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ops": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": ["op", "block"],
            "additionalProperties": false,
            "properties": {
              "op": {
                "enum": ["add", "insert", "replace"]
