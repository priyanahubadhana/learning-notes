  {
    "id": "cards.make_recall",
    "version": 1,
    "label": "Make recall cards",
    "group": "Cards",
    "summary": "Turns the notes into question and answer cards.",
    "aiDescription": "Adds question and answer cards to an existing page, under its Recall cards heading. Needs pageId from an earlier step. Give cards, or a count and a brief. For fill-in-the-blank cards use cards.make_cloze. Not for quizzes.",
    "inputs": {
      "type": "object",
      "required": ["pageId"],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": ["cards"]
        },
        {
          "required": ["count"]
        }
      ],
      "properties": {
        "pageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "cards": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "type": "object",
            "required": ["kind", "q", "a"],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "qa"
              },
              "q": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "a": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "page": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          }
        },
        "expectedVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "outputs": {
      "type": "object",
      "properties": {
        "pageId": {
          "type": "string"
        },
        "cardIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "writes": [
      {
        "target": "blocks",
        "mode": "append"
      },
      {
        "target": "cards",
        "mode": "create"
      }
    ],
    "permissions": {
      "scope": "notes:write",
      "respectsLocks": true,
      "needsSources": true
    },
    "cost": {
      "class": "small",
      "fill": "model",
      "outTokens": 900
    },
    "tier": "simple",
    "reversible": "batch",
    "risk": "direct",
    "idempotent": true,
    "limits": {
      "timeoutMs": 60000,
      "maxRetries": 3
    },
    "surfaces": ["app", "mcp"],
    "offline": false
